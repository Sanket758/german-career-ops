{
  "$schema": "https://raw.githubusercontent.com/everything-claude-code/everything-claude-code/main/schemas/ecc-install-config.schema.json",
  "version": 1,
  "target": "opencode",
  "modules": [
    "commands-core",
    "hooks-runtime",
    "platform-configs",
    "shared-script-utils",
    "skill-unified-memory",
    "skill-python-patterns",
    "skill-python-testing",
    "skill-pytorch-patterns",
    "skill-ml-adoption-playbook",
    "skill-videodb",
    "skill-browser-qa",
    "skill-e2e-testing",
    "skill-accessibility",
    "skill-fastapi-patterns",
    "skill-error-handling",
    "skill-blender-motion-state-inspection",
    "skill-mcp-server-patterns",
    "skill-mcp-dependency-review",
    "skill-ecc-guide",
    "skill-configure-ecc",
    "skill-config-gc",
    "skill-skill-scout",
    "skill-git-workflow",
    "skill-github-ops",
    "skill-safety-guard",
    "skill-react-patterns",
    "skill-react-testing",
    "skill-react-performance",
    "skill-vite-patterns",
    "skill-conventional-commit-review",
    "skill-change-impact",
    "skill-module-regression",
    "skill-growth-log",
    "skill-design-system"
  ],
  "options": {
    "hooks": "enabled",
    "note": "Trimmed surface for this repo (Node/ESM + Python + a React/Vite dashboard). The remaining ECC skills stay on-demand in ~/.config/opencode/skills-library/. Restore one with: mv ~/.config/opencode/skills-library/<skill> ~/.config/opencode/skills/"
  }
}
