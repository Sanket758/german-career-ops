{
  "manifest_version": 3,
  "name": "Career-Ops: Job Application Assistant",
  "version": "1.0.0",
  "description": "Evaluate job postings against your profile, generate tailored CVs and cover letters, track applications",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.stepstone.de/*",
    "https://*.xing.com/*",
    "https://*.jobs.de/*",
    "https://*.indeed.com/*",
    "https://*.glassdoor.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://*.stepstone.de/*",
        "https://*.xing.com/jobs/*",
        "https://*.jobs.de/jobs/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}